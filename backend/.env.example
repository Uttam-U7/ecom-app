# Never commit a real .env file. Use a managed secret store in production.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_TEST_SECRET=replace-with-a-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-different-secret
CORS_ORIGINS=http://localhost:5173
ADMIN_API_TOKEN=replace-with-a-long-random-token
FLASK_ENV=production